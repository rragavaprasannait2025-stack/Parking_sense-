# ParkSense-X Frontend Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to source control

# API base URL (default: /api — proxied to Spring Boot on port 8080)
VITE_API_BASE=/api

# WebSocket base URL (default: /ws)
VITE_WS_BASE=/ws

# Demo / Simulation mode — set to false to connect to real backend
# When true, all data is simulated and labeled with ⚡ SIMULATION DATA
VITE_DEMO_MODE=true
